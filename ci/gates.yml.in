# purpose: CI gates on every push: the full `wsc gates` set (schemas, registries, tool rows, strict JSON, Windows paths, doc size, undated
#          "verified", conflict markers, line endings, host tests) on Linux and Windows, the proxy DLL build and tests, the harness host tests.
# usage: runs on GitHub Actions; locally: python3 wsc.py gates
# when: automatic; main's ruleset should require the checks in wsc.toml [ci] required_checks (`python3 wsc.py ci check-settings` says what is missing).
# No installs: the core is Python 3.12 standard library only.
# Generated blocks (`changes`, `notify`, each slow job's `if:` and pass-marker steps, the fetch cache) come from warscape/ci_render.py and
# wsc.toml [ci]: edit this template, then run `python3 wsc.py ci render` and commit both files (the `ci_render` gate compares them).
# One run per commit (napoleon J42, W21): push only, never pull_request. Checks attach to the commit, so a pull request shows this push run's
# checks on its head; `policy` needs the pull request and lives in policy.yml. A newer push cancels an older run on the same branch, never on main.
# Pass markers (napoleon J54, J57): `proxy` and `harness-windows` run only when their inputs (wsc.toml [ci] inputs) changed and that input tree
# has not passed already; a skipped job counts as passed for required checks and auto-merge, so a docs-only branch does not wait for them.
# Fail safe: each slow job's `if:` starts with `!cancelled()` and runs whenever `changes` did not succeed; a cache error, an empty hash or an
# unreadable marker runs the job.
name: gates
on:
  push:
permissions:
  contents: read
concurrency:
  group: gates-${{ github.ref }}
  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}
jobs:
{{wsc changes}}
  gates:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest]
    runs-on: ${{ matrix.os }}
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v5
        with:
          fetch-depth: 1
      - uses: actions/setup-python@v6
        with:
          python-version: '3.12'
      - name: wsc gates (full set)
        run: python wsc.py gates

  # proxy (napoleon J12): the proxy core moved here. Build the DLL with the null game (proxy/tests/null_game), run every C++ host test,
  # prove the DLL does not depend on the checkout path, and smoke it under wine. WSP_BUILD_ID: build_id.py hashes a game repo's inputs,
  # and the null game is a folder inside this repo (backlog B16).
  proxy:
    needs: changes
{{wsc if proxy}}
    runs-on: ubuntu-24.04
    timeout-minutes: 30   # J30: RmlUi and FreeType compile twice (mingw for the DLL, g++ for the host tests)
    env:
      WSP_GAME_ROOT: proxy/tests/null_game   # relative to the checkout: layout.py resolves it
      WSP_BUILD_ID: nullgame-ci
    steps:
      - uses: actions/checkout@v5
        with:
          fetch-depth: 1
      - name: W24 toolchain probe (temporary; stops the job on purpose)
        run: |
          sudo apt-get update -q >/dev/null
          echo "== runner: preinstalled"; dpkg-query -W -f '${db:Status-Abbrev} ${Package}=${Version}\n' '*mingw-w64*' 2>&1 | sort || true
          sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends g++-mingw-w64-i686-win32 >/dev/null
          echo "== runner: installed"; dpkg-query -W -f '${db:Status-Abbrev} ${Package}=${Version}\n' '*mingw-w64*' | sort
          echo "== runner: madison"; for p in $(dpkg-query -W -f '${Package}\n' '*mingw-w64*' | sort); do apt-cache madison "$p"; done
          echo "== runner: version lines"; i686-w64-mingw32-g++-win32 --version | head -1; i686-w64-mingw32-ld --version | head -1
          readlink -f "$(command -v i686-w64-mingw32-g++-win32)"; dpkg -S "$(readlink -f "$(command -v i686-w64-mingw32-g++-win32)")"
          echo "== runner: sources"; grep -rh '^Suites\|^URIs\|^deb ' /etc/apt/sources.list /etc/apt/sources.list.d/ 2>/dev/null | sort -u
          docker run --rm ubuntu@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852 bash -c '
            apt-get update -q >/dev/null; DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends g++-mingw-w64-i686-win32 >/dev/null
            echo "== image: installed"; dpkg-query -W -f "\${db:Status-Abbrev} \${Package}=\${Version}\n" "*mingw-w64*" | sort
            echo "== image: madison"; for p in $(dpkg-query -W -f "\${Package}\n" "*mingw-w64*" | sort); do apt-cache madison "$p"; done
            echo "== image: version lines"; i686-w64-mingw32-g++-win32 --version | head -1; i686-w64-mingw32-ld --version | head -1
            echo "== image: sources"; grep -rh "^Suites\|^URIs\|^deb " /etc/apt/sources.list /etc/apt/sources.list.d/ 2>/dev/null | sort -u'
          exit 1
      - run: sudo apt-get update -q && sudo apt-get install -y -q g++-mingw-w64-i686
{{wsc fetch_cache}}
      - run: proxy/tools/build.sh all
      - name: the DLL is byte-identical when built from another checkout path
        run: proxy/tools/build.sh repro
      - name: smoke test the DLL under wine (a stand-in exe loads it; guard verdicts, config, log, clean detach)
        run: |
          sudo dpkg --add-architecture i386 && sudo apt-get update -q
          sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends wine wine32:i386
          proxy/tools/build.sh smoke
{{wsc pass_marker proxy}}

  # harness-windows (napoleon J12): the watcher kit moved here. Its unit and integration host tests under Windows PowerShell 5.1 with
  # compiled fake games; the installer case builds a real harness kit from the null game's adapter.
  harness-windows:
    needs: changes
{{wsc if harness}}
    runs-on: windows-latest
    timeout-minutes: 25
    env:
      CI: 'true'
      WSP_GAME_ROOT: proxy/tests/null_game   # relative to the checkout: layout.py resolves it
    steps:
      - uses: actions/checkout@v5
        with:
          fetch-depth: 1
      - uses: actions/setup-python@v6
        with:
          python-version: '3.12'
      - name: python3 for job.sh (setup-python gives python only)
        shell: powershell
        run: |
          $py = (Get-Command python).Source
          $py3 = Join-Path (Split-Path $py) 'python3.exe'
          if (-not (Test-Path $py3)) { Copy-Item $py $py3 }
      # W8: the job.sh and Git Bash finder tests too; WSC_REQUIRE_BASH turns their "no Git Bash or python3" skip into a failure here
      - name: moved tools host tests that run bash (Git Bash found explicitly)
        timeout-minutes: 8
        shell: powershell
        env:
          WSC_REQUIRE_BASH: '1'
        run: |
          python -m unittest tests.test_moved_tools tests.test_job_sh tests.test_gitbash
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
      - name: harness host tests (unit and integration)
        timeout-minutes: 18
        shell: powershell
        run: ./harness/tests/Run-HostTests.ps1 -Suite all
{{wsc pass_marker harness shell=bash}}

  # notify: the last job; a failure in any job above, on a branch with an open pull request, comments once there (a failed check leaves the
  # pull request open: this makes it impossible to miss). The only job with write access, and only to pull requests.
{{wsc notify gates needs=changes,gates,proxy,harness-windows}}
