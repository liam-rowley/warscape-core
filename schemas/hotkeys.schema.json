{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "warscape-core/schemas/hotkeys.schema.json",
  "title": "Hotkeys",
  "description": "Every key binding, vanilla and mod: the gate fails on any clash (same binding in the same context, or in `global`).",
  "type": "object",
  "required": [
    "id",
    "description",
    "binding",
    "action",
    "context",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "description": {
      "$ref": "#/$defs/text"
    },
    "binding": {
      "type": "string",
      "pattern": "^(Ctrl\\+)?(Alt\\+)?(Shift\\+)?([A-Z0-9]|F([1-9]|1[0-9]|2[0-4])|[A-Z][A-Za-z0-9]+)$",
      "not": {
        "enum": [
          "Alt+F4",
          "Alt+Tab",
          "Ctrl+Alt+Delete",
          "Ctrl+Shift+Escape"
        ]
      },
      "description": "canonical form: modifiers in the order Ctrl+Alt+Shift, then one key (A, 7, F4, Space, LeftDrag)"
    },
    "action": {
      "$ref": "#/$defs/text"
    },
    "context": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "where it applies; `global` clashes with every context"
    },
    "source": {
      "enum": [
        "vanilla",
        "mod"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "description": "the vanilla key file, or the mod component"
    }
  },
  "x-view": {
    "columns": [
      "id",
      "binding",
      "context",
      "action",
      "source"
    ]
  },
  "x-unique": [
    [
      "binding",
      "context"
    ]
  ],
  "x-wildcard": {
    "context": "global"
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "mod"
          }
        }
      },
      "then": {
        "properties": {
          "binding": {
            "not": {
              "pattern": "(^|\\+)F4$"
            }
          }
        }
      },
      "description": "Empire learning: Alt is held for the move gesture, so a mod hotkey on F4 becomes Alt+F4"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:/#-]*$",
      "maxLength": 120
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
