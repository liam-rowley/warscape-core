{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "warscape-core/schemas/config_keys.schema.json",
  "title": "Config keys",
  "description": "Every configuration key the mod reads: its default, its release value, who owns it and what it does (the description).",
  "type": "object",
  "required": [
    "id",
    "description",
    "default",
    "owner"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "description": {
      "$ref": "#/$defs/text"
    },
    "default": {
      "description": "any JSON value"
    },
    "release_value": {
      "description": "any JSON value"
    },
    "owner": {
      "$ref": "#/$defs/text"
    },
    "type": {
      "enum": [
        "bool",
        "int",
        "float",
        "string"
      ],
      "description": "the key's type; without it the type is inferred from default (JSON 0 is an int, so a float key with default 0 needs type float; a key named by an engine_sites value_key must carry it)"
    },
    "min": {
      "type": "number",
      "description": "numeric keys only: a value below it is clamped to it (with a warning)"
    },
    "max": {
      "type": "number",
      "description": "numeric keys only: a value above it is clamped to it (with a warning); for a value_key, the tested ceiling"
    }
  },
  "x-view": {
    "columns": [
      "id",
      "default",
      "release_value",
      "owner",
      "description"
    ]
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "min"
            ]
          },
          {
            "required": [
              "max"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "int",
              "float"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:/#-]*$",
      "maxLength": 120
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  }
}
