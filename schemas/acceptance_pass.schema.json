{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "warscape-core/schemas/acceptance_pass.schema.json",
  "title": "Acceptance pass file (schema 2)",
  "description": "harness/runs/<run>/pass_NN.json, written by harness/acceptance.py run (W9): one attempt, its steps and the evidence that ties it to the exact files it ran on. acceptance.pass_problems adds the cross-field rules (a pass names its build); this schema is the shape.",
  "type": "object",
  "required": ["schema", "pass", "start_utc", "end_utc", "result", "passed", "build_id", "build_source", "watcher", "kit", "steps", "evidence"],
  "properties": {
    "schema": {"const": 2},
    "pass": {"type": "integer", "minimum": 1, "description": "the attempt number in the run (a flake takes a number too)"},
    "start_utc": {"type": "string", "minLength": 1},
    "end_utc": {"type": "string", "minLength": 1},
    "result": {"enum": ["pass", "fail", "flake"]},
    "passed": {"type": "boolean"},
    "build_id": {"type": ["string", "null"], "description": "the DLL build from this pass's own launch line in proxy.log; null when no launch logged one (never a pass)"},
    "build_source": {"const": "proxy.log"},
    "watcher": {"type": ["string", "null"], "description": "the watcher's $Version, display only: its identity is evidence.watcher_sha256"},
    "kit": {"type": ["string", "null"]},
    "steps": {"type": "object", "additionalProperties": {"type": "object", "required": ["ok"], "properties": {"ok": {"type": "boolean"}}}},
    "evidence": {
      "type": "object",
      "required": ["exe_sha1", "baseline_sha256", "shots", "kit_sha256", "dll_sha256", "dll_sha256_logged", "watcher_sha256", "watcher_kit_sha256", "launches"],
      "properties": {
        "exe_sha1": {"type": ["string", "null"]},
        "baseline_sha256": {"type": ["string", "null"]},
        "shots": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["sha256", "bytes"],
            "properties": {
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "bytes": {"type": "integer", "minimum": 0},
              "baseline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "kit_sha256": {"type": ["string", "null"]},
        "dll_sha256": {"type": ["string", "null"]},
        "dll_sha256_logged": {"type": ["string", "null"]},
        "watcher_sha256": {"type": ["string", "null"]},
        "watcher_kit_sha256": {"type": ["string", "null"]},
        "launches": {"type": "array", "items": {"type": "object", "required": ["pid", "build", "dll_sha256_logged", "utc"]}}
      }
    }
  }
}
